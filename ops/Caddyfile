:80 {
    root * /srv
    encode gzip zstd

    @api path /api/* /health/*
    handle @api {
        reverse_proxy api:8000 {
            transport http {
                read_timeout 15m
                write_timeout 15m
            }
        }
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    header {
        Permissions-Policy "microphone=(self)"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 20MiB
            roll_keep 5
        }
        format json
    }
}
