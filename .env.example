APP_ENV=development
APP_SECRET=change-me-to-a-long-random-secret
DATABASE_URL=postgresql+psycopg://voice:voice@db:5432/voice_collector
MEDIA_ROOT=/srv/voice-collector/recordings
MAX_UPLOAD_BYTES=52428800
MAX_RECORDING_SECONDS=480
EXPECTED_RECORDING_SECONDS=180
ADMIN_USERNAME=researcher
ADMIN_PASSWORD=change-me
ADMIN_TOTP_SECRET=
PUBLIC_BASE_URL=https://voice.example.org
WEB_PORT=5173
POSTGRES_PASSWORD=change-me-to-a-database-password
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_RPM_LIMIT=90
MIMO_ASR_PARTICIPANT_INTERVAL_SECONDS=7.5
MIMO_REQUIRED_CONSENT_VERSION=consent-v2-mimo-asr

# Build mirrors (Compose and the ECS Podman deployment script share these settings).
APT_MIRROR=https://mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmmirror.com
# Optional ECS VPC internal mirrors (HTTP; use only within the Aliyun network):
# APT_MIRROR=http://mirrors.cloud.aliyuncs.com
# PIP_INDEX_URL=http://mirrors.cloud.aliyuncs.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.cloud.aliyuncs.com
# Optional images from your own Aliyun ACR repository; defaults reuse local images.
PYTHON_IMAGE=python:3.13-slim
NODE_IMAGE=node:22-alpine
CADDY_IMAGE=caddy:2-alpine
